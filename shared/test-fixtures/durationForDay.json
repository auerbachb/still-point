{
  "algorithm": "durationAndProgression",
  "description": "Golden values for durationForDay, advanceProgression, and detectMissedDayGap. Web src/lib/duration.ts + src/lib/constants.ts and iOS StillPointShared share these algorithms via DurationRecovery.swift. Includes cap/fork-day (#240) and missed-day recovery cases (#238/#559/#524).",
  "constants": {
    "baseDuration": 60,
    "increment": 10,
    "maxDuration": 600,
    "forkDay": 55,
    "recoveryMaxSteps": 5,
    "missedDayGapThreshold": 2
  },
  "durationForDay": [
    { "day": 1, "expected": 60 },
    { "day": 2, "expected": 70 },
    { "day": 45, "expected": 500 },
    { "day": 46, "expected": 510 },
    { "day": 54, "expected": 590 },
    { "day": 55, "expected": 600 },
    { "day": 56, "expected": 600 },
    { "day": 200, "expected": 600 }
  ],
  "isDualTrackEligible": [
    { "currentDay": 1, "expected": false },
    { "currentDay": 55, "expected": false },
    { "currentDay": 56, "expected": true }
  ],
  "advanceProgression": [
    {
      "name": "completed standard sit outside recovery bumps currentDay",
      "sessionType": "standard",
      "completed": true,
      "state": { "currentDay": 45, "recoveryTargetDay": null, "recoveryCurrentStep": null, "recoveryTotalSteps": null },
      "expected": { "currentDay": 46, "recoveryTargetDay": null, "recoveryCurrentStep": null, "recoveryTotalSteps": null }
    },
    {
      "name": "mid-recovery step leaves currentDay frozen",
      "sessionType": "standard",
      "completed": true,
      "state": { "currentDay": 45, "recoveryTargetDay": 45, "recoveryCurrentStep": 2, "recoveryTotalSteps": 5 },
      "expected": { "currentDay": 45, "recoveryTargetDay": 45, "recoveryCurrentStep": 3, "recoveryTotalSteps": 5 }
    },
    {
      "name": "final recovery step clears recovery and advances currentDay (#559)",
      "sessionType": "standard",
      "completed": true,
      "state": { "currentDay": 45, "recoveryTargetDay": 45, "recoveryCurrentStep": 5, "recoveryTotalSteps": 5 },
      "expected": { "currentDay": 46, "recoveryTargetDay": null, "recoveryCurrentStep": null, "recoveryTotalSteps": null }
    },
    {
      "name": "quick sit never advances",
      "sessionType": "quick",
      "completed": true,
      "state": { "currentDay": 45, "recoveryTargetDay": null, "recoveryCurrentStep": null, "recoveryTotalSteps": null },
      "expected": { "currentDay": 45, "recoveryTargetDay": null, "recoveryCurrentStep": null, "recoveryTotalSteps": null }
    },
    {
      "name": "repeated miss at day 45 advances to 46 after final recovery step (#559/#524)",
      "sessionType": "standard",
      "completed": true,
      "state": { "currentDay": 45, "recoveryTargetDay": 45, "recoveryCurrentStep": 5, "recoveryTotalSteps": 5 },
      "expected": { "currentDay": 46, "recoveryTargetDay": null, "recoveryCurrentStep": null, "recoveryTotalSteps": null }
    },
    {
      "name": "second recovery cycle at day 46 steps mid-ramp without bumping currentDay",
      "sessionType": "standard",
      "completed": true,
      "state": { "currentDay": 46, "recoveryTargetDay": 46, "recoveryCurrentStep": 2, "recoveryTotalSteps": 5 },
      "expected": { "currentDay": 46, "recoveryTargetDay": 46, "recoveryCurrentStep": 3, "recoveryTotalSteps": 5 }
    },
    {
      "name": "second recovery cycle at day 46 clears and advances to 47",
      "sessionType": "standard",
      "completed": true,
      "state": { "currentDay": 46, "recoveryTargetDay": 46, "recoveryCurrentStep": 5, "recoveryTotalSteps": 5 },
      "expected": { "currentDay": 47, "recoveryTargetDay": null, "recoveryCurrentStep": null, "recoveryTotalSteps": null }
    }
  ],
  "detectMissedDayGap": [
    {
      "name": "no gap with one calendar day between sits",
      "lastCompletedSessionDate": "2026-06-10",
      "todayIso": "2026-06-11",
      "currentDay": 45,
      "recovery": { "recoveryTargetDay": null, "recoveryCurrentStep": null, "recoveryTotalSteps": null },
      "expected": null
    },
    {
      "name": "2+ day gap starts recovery at currentDay",
      "lastCompletedSessionDate": "2026-06-09",
      "todayIso": "2026-06-11",
      "currentDay": 45,
      "recovery": { "recoveryTargetDay": null, "recoveryCurrentStep": null, "recoveryTotalSteps": null },
      "expected": { "recoveryTargetDay": 45, "recoveryCurrentStep": 1, "recoveryTotalSteps": 5 }
    },
    {
      "name": "already recovering does not restart ramp",
      "lastCompletedSessionDate": "2026-05-01",
      "todayIso": "2026-06-11",
      "currentDay": 45,
      "recovery": { "recoveryTargetDay": 45, "recoveryCurrentStep": 3, "recoveryTotalSteps": 5 },
      "expected": null
    },
    {
      "name": "re-enter recovery at day 46 after prior cycle cleared",
      "lastCompletedSessionDate": "2026-06-01",
      "todayIso": "2026-06-04",
      "currentDay": 46,
      "recovery": { "recoveryTargetDay": null, "recoveryCurrentStep": null, "recoveryTotalSteps": null },
      "expected": { "recoveryTargetDay": 46, "recoveryCurrentStep": 1, "recoveryTotalSteps": 5 }
    }
  ],
  "recoveryStepDuration": [
    {
      "name": "day 45 recovery ramp step 1 resets to 60s (already block-aligned)",
      "targetDay": 45,
      "totalSteps": 5,
      "step": 1,
      "expected": 60
    },
    {
      "name": "day 45 recovery ramp step 2 rounds 148 up to 150 (#661)",
      "targetDay": 45,
      "totalSteps": 5,
      "step": 2,
      "expected": 150
    },
    {
      "name": "day 45 recovery ramp step 3 rounds 236 up to 240 (#661)",
      "targetDay": 45,
      "totalSteps": 5,
      "step": 3,
      "expected": 240
    },
    {
      "name": "day 45 recovery ramp step 4 rounds 324 down to 320 (#661)",
      "targetDay": 45,
      "totalSteps": 5,
      "step": 4,
      "expected": 320
    },
    {
      "name": "day 45 recovery ramp step 5 rounds 412 down to 410 before landing sit (#661)",
      "targetDay": 45,
      "totalSteps": 5,
      "step": 5,
      "expected": 410
    },
    {
      "name": "day 6 ramp is already a whole number of blocks and is unchanged",
      "targetDay": 6,
      "totalSteps": 5,
      "step": 4,
      "expected": 90
    },
    {
      "name": "x5 midpoint rounds up: raw 75 becomes 80 on both clients (#661)",
      "targetDay": 4,
      "totalSteps": 2,
      "step": 2,
      "expected": 80
    },
    {
      "name": "non-terminating ramp still lands on a whole block: raw 66.67 becomes 70 (#661)",
      "targetDay": 3,
      "totalSteps": 3,
      "step": 2,
      "expected": 70
    },
    {
      "name": "smallest ramp never rounds below one block: day 2 step 1 stays 60",
      "targetDay": 2,
      "totalSteps": 1,
      "step": 1,
      "expected": 60
    },
    {
      "name": "totalSteps 0 returns the block-aligned base duration",
      "targetDay": 45,
      "totalSteps": 0,
      "step": 1,
      "expected": 60
    }
  ]
}
